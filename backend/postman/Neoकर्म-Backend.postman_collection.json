              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/daily-log/history?from=2024-01-01&to=2024-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "daily-log", "history"],
              "query": [
                {
                  "key": "from",
                  "value": "2024-01-01"
                },
                {
                  "key": "to",
                  "value": "2024-12-31"
                }
              ]
            }
          }
        }
